{
  "name": "strands-lambda-durable-functions",
  "version": "0.2.0",
  "description": "A Strands Agents (TypeScript) extension for AWS Lambda durable functions: one durable step per model call and tool use, parallel tools with a deterministic journal, and human-in-the-loop via durable callbacks.",
  "keywords": [
    "strands-agents",
    "aws-lambda",
    "durable-functions",
    "durable-execution",
    "ai-agents",
    "strands-extension"
  ],
  "license": "MIT",
  "author": "har1101",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/har1101/strands-lambda-durable-functions.git"
  },
  "homepage": "https://github.com/har1101/strands-lambda-durable-functions#readme",
  "bugs": {
    "url": "https://github.com/har1101/strands-lambda-durable-functions/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "import": "./dist/s3.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws/durable-execution-sdk-js": ">=2.4.0 <3",
    "@strands-agents/sdk": ">=1.18.0 <2",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws/durable-execution-sdk-js": "^2.4.0",
    "@aws/durable-execution-sdk-js-testing": "^1.1.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@strands-agents/sdk": "^1.18.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  }
}
